{
  "name": "bay-chicken-beta",
  "version": "0.8.0-beta.2",
  "private": true,
  "description": "大湾鸡 · Windows / macOS 三维桌面伙伴",
  "main": "electron/main.cjs",
  "author": {
    "name": "MikeJack302"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/MikeJack302/bay-chicken-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/MikeJack302/bay-chicken-desktop.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "node scripts/build.mjs && node scripts/pack.mjs",
    "exe": "node scripts/build.mjs && electron-builder --config electron-builder.yml --win nsis portable --x64 --publish never",
    "beta": "node scripts/build.mjs && electron-builder --config electron-builder.beta.yml --win portable --x64 --publish never",
    "beta:mac": "node scripts/build.mjs && electron-builder --config electron-builder.macos.yml --mac --publish never"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "playwright": "1.62.1"
  }
}
